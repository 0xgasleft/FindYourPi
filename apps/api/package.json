    "@pi-hunter/proofs": "workspace:*",
    "dotenv": "16.4.5",
    "fastify": "5.0.0",
    "pg": "8.13.1",
    "viem": "2.21.19",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@pi-hunter/config": "workspace:*",
    "@types/node": "20.14.10",
