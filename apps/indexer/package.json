{
  "name": "@pi-hunter/indexer",
  "private": true,
  "version": "0.1.0",
  "description": "Watches PiHunterNFT's DiscoveryClaimed/Transfer events and keeps Postgres (discoveries/claims/nfts) in sync. See docs/architecture.md §30 for reorg/idempotency handling.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "16.4.5",
    "pg": "8.13.1",
    "viem": "2.21.19",
    "@pi-hunter/types": "workspace:*"
  },
  "devDependencies": {
    "@pi-hunter/config": "workspace:*",
    "@types/node": "20.14.10",
    "@types/pg": "8.11.10",
    "tsx": "4.19.1",
    "typescript": "5.5.3",
    "vitest": "2.0.5"
  }
}
