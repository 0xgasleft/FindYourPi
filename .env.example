# Copy to .env (or per-app .env / .env.local  -  see README.md "Local
# development") and fill in. Never commit the real .env file  -  it already
# is gitignored.
#
# Nothing in THIS file is a secret. POSTGRES_* below are throwaway local-dev
# defaults (not a real credential); PI_DATASET_HASH/ROOT are public
# cryptographic commitments  -  the entire point of the proof system
# (docs/proof-system.md) is that they're meant to be published. The only
# genuinely sensitive field is DEPLOYER_PRIVATE_KEY, which is intentionally
# left blank here and must never be filled in with a real key in anything
# you commit.

# --- Database (apps/api, apps/indexer) ---
# Local dev-only default credential  -  not a secret, safe to commit.
POSTGRES_USER=pihunter
POSTGRES_PASSWORD=pihunter
POSTGRES_DB=pihunter
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pihunter:pihunter@localhost:5432/pihunter

# --- Chain (apps/api, apps/indexer, apps/web) ---
# Base Sepolia (testnet) for development; see docs/architecture.md §3 for the
# chain-selection rationale. Never hardcode this  -  always read from env.
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
NFT_CONTRACT_ADDRESS=
DATASET_REGISTRY_ADDRESS=
# Deployer key for local/testnet contract deployment ONLY. Leave blank here.
# Never commit a real value, never expose it to frontend code (it must only
# ever be read by packages/contracts' Hardhat config / deploy script), never
# use a mainnet key for local/testnet work.
DEPLOYER_PRIVATE_KEY=

# --- π dataset (apps/api, apps/indexer, packages/pi-search) ---
# These are the REAL values from the actual generated v2 dataset  -  a public
# cryptographic commitment, not a secret (see docs/proof-system.md §5:
# anyone can independently regenerate the dataset and recompute these).
# Run `pnpm --filter @pi-hunter/pi-search generate` to reproduce them (needs
# real native GMP, not just native BigInt, at this scale  -  see
# docs/architecture.md §5.1 for the full generation-environment story).
PI_DATASET_VERSION=2
PI_DATASET_PATH=../../packages/pi-search/data/v2
PI_DATASET_HASH=0x502214f973ea44d9a04362dc9e7fb9dede34d2c7b7de51c0728feb47173b9546
PI_DATASET_ROOT=0xcf6a6a7d18118fe5c37297076e387b4374364ee72e526e20b055ff35a74c591c
PI_DATASET_CHUNK_SIZE=128
# v2 is a real, generated 500,000,000-digit dataset (see packages/pi-search)
#  -  not the aspirational "trillion decimals" from early planning docs, but
# 6.25x v1's original 80,000,000 digits. 500M is the real, measured ceiling
# for this project's generation pipeline today: reaching it required
# replacing native BigInt with real native GMP (packages/gmp-native) to get
# past V8's ~93M-digit BigInt ceiling, then running generation on Linux/WSL2
# rather than native Windows (a Windows CRT allocator limitation caps native
# generation around ~350-400M digits  -  confirmed by reproducing the exact
# same operation succeeding instantly on Linux), with 24GB+ RAM available.
# See docs/architecture.md §5.1 for the complete, measured investigation
# (four distinct ceilings found and worked through) and why 500M, not 1B or
# 10B, is where this landed  -  1B needs more RAM than is practical on the
# machine this was built on, not more code.
PI_DATASET_DIGIT_COUNT=500000000

# --- Storage (apps/api  -  NFT metadata/artwork) ---
STORAGE_PROVIDER=
STORAGE_BUCKET=

# --- apps/web (NEXT_PUBLIC_* vars are exposed to the browser by design  -
# never put anything sensitive under a NEXT_PUBLIC_ name) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CHAIN_ID=5042
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.arc.io
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=

# --- Arc grant POC deployment (packages/contracts only; never expose this) ---
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
