# Copy to .env (or per-app .env / .env.local — see README.md "Local
# development") and fill in. Never commit the real .env file — it already
# is gitignored.
#
# Nothing in THIS file is a secret. POSTGRES_* below are throwaway local-dev
# defaults (not a real credential); PI_DATASET_HASH/ROOT are public
# cryptographic commitments — the entire point of the proof system
# (docs/proof-system.md) is that they're meant to be published. The only
# genuinely sensitive field is DEPLOYER_PRIVATE_KEY, which is intentionally
# left blank here and must never be filled in with a real key in anything
# you commit.

# --- Database (apps/api, apps/indexer) ---
# Local dev-only default credential — not a secret, safe to commit.
POSTGRES_USER=pihunter
POSTGRES_PASSWORD=pihunter
POSTGRES_DB=pihunter
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pihunter:pihunter@localhost:5432/pihunter

# --- Chain (apps/api, apps/indexer, apps/web) ---
# Base Sepolia (testnet) for development; see docs/architecture.md §3 for the
# chain-selection rationale. Never hardcode this — always read from env.
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
NFT_CONTRACT_ADDRESS=
DATASET_REGISTRY_ADDRESS=
# Deployer key for local/testnet contract deployment ONLY. Leave blank here.
# Never commit a real value, never expose it to frontend code (it must only
# ever be read by packages/contracts' Hardhat config / deploy script), never
# use a mainnet key for local/testnet work.
DEPLOYER_PRIVATE_KEY=

# --- π dataset (apps/api, apps/indexer, packages/pi-search) ---
# These are the REAL values from the actual generated v1 dataset — a public
# cryptographic commitment, not a secret (see docs/proof-system.md §5:
# anyone can independently regenerate the dataset and recompute these).
# Run `pnpm --filter @pi-hunter/pi-search generate` to reproduce them.
PI_DATASET_VERSION=1
PI_DATASET_PATH=../../packages/pi-search/data/v1
PI_DATASET_HASH=0x756c307a8835c48601c33d866e7db1fabf498e85a38a2de77f3357187c2a8988
PI_DATASET_ROOT=0x1a78fd7be42cced1c1378bd27df6eda7204e40dd0e3927c591cc4d72ec2c2338
PI_DATASET_CHUNK_SIZE=128
# v1 is a real, generated 50,000,000-digit dataset (see packages/pi-search)
# — not the aspirational "first billion" from early planning docs. See
# README.md / docs/architecture.md for why.
PI_DATASET_DIGIT_COUNT=50000000

# --- Storage (apps/api — NFT metadata/artwork) ---
STORAGE_PROVIDER=
STORAGE_BUCKET=

# --- apps/web (NEXT_PUBLIC_* vars are exposed to the browser by design —
# never put anything sensitive under a NEXT_PUBLIC_ name) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CHAIN_ID=84532
